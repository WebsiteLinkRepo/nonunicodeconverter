---
import '../styles/global.css';
import { TRANSLATIONS, type Language } from '../utils/i18n';
import { faqData } from '../data/faq';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	lang?: Language;
}

const {
	title = "Unicode to Anu 7.0 Telugu Converter | legacy Font Converter",
	description = "Convert Telugu Unicode text to legacy Anu Script 7.0 font formats (Priyanka, Anupama, Subhalekha, Bapu Script, Ramana Script, Gowthami) instantly.",
	keywords = "unicode to non unicode, unicode to non unicode converter telugu, unicode to non unicode anu 7.0, anu unicode, unicode converter telugu, unicode to non unicode font, indesign telugu font converter, photoshop telugu font converter, anu script 7 telugu converter",
	lang = 'en'
} = Astro.props;

const t = TRANSLATIONS[lang];

const canonicalUrl = Astro.url.pathname === '/' ? 'https://nonunicodeconverter.com/' : `https://nonunicodeconverter.com/${lang}`;

const localeMap: Record<Language, string> = {
	en: 'en_US',
	te: 'te_IN',
	hi: 'hi_IN',
	ta: 'ta_IN',
	kn: 'kn_IN',
	ml: 'ml_IN',
	mr: 'mr_IN',
	gu: 'gu_IN'
};
const ogLocale = localeMap[lang] || 'en_US';

const faqSchema = {
	"@type": "FAQPage",
	"mainEntity": faqData.map(faq => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.answer
		}
	}))
};

const webAppSchema = {
	"@type": "WebApplication",
	"name": "Unicode to non Unicode converter",
	"alternateName": [
		"unicode to non unicode anu 7.0",
		"telugu unicode to non unicode converter",
		"Hindi Unicode to non Unicode converter",
		"Unicode to non Unicode Converter Tamil"
	],
	"url": "https://nonunicodeconverter.com/",
	"description": "Free online unicode to non unicode converter for converting modern text into legacy font formats across Indian regional languages.",
	"applicationCategory": "UtilitiesApplication",
	"operatingSystem": "All",
	"offers": {
		"@type": "Offer",
		"price": "0",
		"priceCurrency": "USD"
	},
	"browserRequirements": "Requires JavaScript",
	"softwareVersion": "1.0.0"
};

const schemaGraph = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [webAppSchema, faqSchema]
});
---

<!DOCTYPE html>
<html lang={lang} class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Uni2Non" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#171717" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- i18n alternate languages -->
		{
			['en', 'te', 'hi', 'ta', 'kn', 'ml', 'mr', 'gu'].map((l) => {
				let p = Astro.url.pathname;
				// Remove trailing slash
				if (p.endsWith('/')) p = p.slice(0, -1);
				// Remove current lang prefix if present
				if (p === `/${lang}` || p.startsWith(`/${lang}/`)) {
					p = p.substring(lang.length + 1);
				}
				const localeUrl = l === 'en' ? p || '/' : `/${l}${p}`;
				const fullUrl = `https://nonunicodeconverter.com${localeUrl === '/' ? '/' : localeUrl}`;
				return <link rel="alternate" href={fullUrl} hreflang={l} />
			})
		}
		<link rel="alternate" href="https://nonunicodeconverter.com/" hreflang="x-default" />



		<link href="/generated_anusm_fonts.css" rel="stylesheet" />

		<!-- OpenGraph / Facebook Meta Tags -->
		<meta property="og:site_name" content="Unicode To Non Unicode" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content="https://nonunicodeconverter.com/web-app-manifest-512x512.png" />
		<meta property="og:image:secure_url" content="https://nonunicodeconverter.com/web-app-manifest-512x512.png" />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="Unicode To Non Unicode Converter - Free Online Tool for Telugu Anu 7.0, Anu Unicode & Kruti Dev" />
		<meta property="og:locale" content={ogLocale} />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://nonunicodeconverter.com/web-app-manifest-512x512.png" />
		<meta name="twitter:image:alt" content="Unicode To Non Unicode Converter Tool" />

		<!-- Schema.org JSON-LD Structured Data for WebApplication & FAQPage -->
		<script type="application/ld+json" set:html={schemaGraph} />
		
		<!-- Service Worker Registration -->
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}

			// Theme Initializer
			const savedTheme = localStorage.getItem('theme');
			if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="min-h-screen bg-[var(--canvas)] text-[var(--ink)] font-sans antialiased flex flex-col selection:bg-[var(--ink)] selection:text-[var(--canvas)] relative">
		
		<!-- Volumetric Spotlight Background -->
		<div class="fixed inset-0 pointer-events-none -z-10 bg-[var(--canvas)]">
			<canvas id="fx" class="absolute inset-0 w-full h-full"></canvas>
			<div class="absolute inset-0 z-10 pointer-events-none opacity-[0.075]" style='background-image:url("data:image/svg+xml,%3Csvg viewBox=\"0 0 180 180\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cfilter id=\"n\"%3E%3CfeTurbulence type=\"fractalNoise\" baseFrequency=\".85\" numOctaves=\"4\" stitchTiles=\"stitch\"/%3E%3C/filter%3E%3Crect width=\"100%25\" height=\"100%25\" filter=\"url(%23n)\" opacity=\".7\"/%3E%3C/svg%3E"); background-size: 150px; background-repeat: repeat;'></div>
		</div>

		<!-- Main Header Bar -->
		<header class="border-b border-[var(--hairline)] bg-[var(--canvas)]/80 sticky top-0 z-40 backdrop-blur-md">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
				<!-- Brand / Logo -->
				<a href="/" class="flex items-center gap-3 group cursor-pointer flex-shrink-0">
					<img src="/logo-light.svg" alt="NonUnicodeConverter Logo" class="logo-light w-7 h-7 rounded-lg shadow-xs flex-shrink-0" />
					<img src="/logo-dark.svg" alt="NonUnicodeConverter Logo" class="logo-dark w-7 h-7 rounded-lg shadow-xs flex-shrink-0" />
					<span id="logo-title-text" class="font-bold text-sm tracking-tight text-[var(--ink)] hidden sm:block">NonUnicodeConverter</span>
				</a>

				<!-- Navigation & Tools -->
				<div class="flex items-center gap-4 sm:gap-6 flex-shrink-0">
					<!-- Nav Links -->
					<nav class="hidden md:flex items-center gap-4 text-xs font-semibold text-[var(--ink-secondary)]">
						<a href={lang === 'en' ? '/' : `/${lang}`} class="hover:text-[var(--ink)] transition-colors">{t.navConverter}</a>
						<a href={lang === 'en' ? '/how-to-use' : `/${lang}/how-to-use`} class="hover:text-[var(--ink)] transition-colors">{t.navHowToUse}</a>
						<a href={lang === 'en' ? '/about' : `/${lang}/about`} class="hover:text-[var(--ink)] transition-colors">{t.navAbout}</a>
						<a href={lang === 'en' ? '/contact' : `/${lang}/contact`} class="hover:text-[var(--ink)] transition-colors">{t.navContact}</a>
						<a href={lang === 'en' ? '/download' : `/${lang}/download`} class="bg-[var(--ink)] text-[var(--canvas)] px-3 py-1.5 rounded-md font-bold hover:opacity-80 transition-opacity flex items-center gap-1.5">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
							{t.navDownloadApp}
						</a>
					</nav>

					<div class="flex items-center gap-3 border-l border-[var(--hairline)] pl-4 sm:pl-6 ml-2 sm:ml-0">
						<!-- Language Selector -->
						<div class="relative flex items-center bg-[var(--canvas)] border border-[var(--hairline-strong)] rounded-md px-2.5 py-1 text-xs transition-colors shadow-sm group focus-within:ring-1 focus-within:ring-[var(--ink)]">
							<svg class="w-3.5 h-3.5 text-[var(--ink-secondary)] mr-1.5 flex-shrink-0 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
							</svg>
							<select 
								id="lang-select" 
								class="appearance-none bg-transparent text-[var(--ink)] font-semibold border-none cursor-pointer focus:outline-none text-xs pr-5 py-1 touch-target"
								aria-label="Select Language"
							>
								<option value="en" selected={lang === 'en'} class="bg-[var(--card-bg)] text-[var(--ink)] py-1">English</option>
								<option value="hi" selected={lang === 'hi'} class="bg-[var(--card-bg)] text-[var(--ink)] py-1">हिंदी</option>
								<option value="te" selected={lang === 'te'} class="bg-[var(--card-bg)] text-[var(--ink)] py-1">తెలుగు</option>
								<option value="ta" selected={lang === 'ta'} class="bg-[var(--card-bg)] text-[var(--ink)] py-1">தமிழ்</option>
								<option value="kn" selected={lang === 'kn'} class="bg-[var(--card-bg)] text-[var(--ink)] py-1">ಕನ್ನಡ</option>
								<option value="ml" selected={lang === 'ml'} class="bg-[var(--card-bg)] text-[var(--ink)] py-1">മലയാളം</option>
								<option value="mr" selected={lang === 'mr'} class="bg-[var(--card-bg)] text-[var(--ink)] py-1">मराठी</option>
								<option value="gu" selected={lang === 'gu'} class="bg-[var(--card-bg)] text-[var(--ink)] py-1">ગુજરાતી</option>
							</select>
							<svg class="w-3 h-3 text-[var(--ink-tertiary)] group-hover:text-[var(--ink)] absolute right-2 pointer-events-none transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
							</svg>
						</div>

						<!-- Theme Switcher -->
						<button 
							id="theme-toggle-btn" 
							type="button" 
							class="vercel-focus p-1.5 rounded-md border border-[var(--hairline-strong)] bg-[var(--canvas)] text-[var(--ink-secondary)] hover:text-[var(--ink)] hover:bg-[var(--canvas-soft)] transition-colors cursor-pointer shadow-sm flex items-center justify-center"
							aria-label="Toggle Dark/Light Mode"
						>
							<svg id="theme-icon-dark" class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
							</svg>
							<svg id="theme-icon-light" class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
							</svg>
						</button>
					</div>
				</div>
			</div>
		</header>

		<!-- Main Area -->
		<main class="flex-grow max-w-6xl w-full mx-auto px-3 sm:px-6 py-2 sm:py-4">
			<slot />
		</main>

		<!-- Comprehensive Multi-Column Footer for MPA SEO -->
		<footer class="border-t border-[var(--hairline)] bg-[var(--canvas-soft)] py-8 sm:py-12 text-xs text-[var(--ink-secondary)]">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
				<!-- Footer Navigation Grid -->
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
					<!-- Col 1: Brand Info -->
					<div class="space-y-3">
						<div class="flex items-center gap-2 font-semibold text-sm text-[var(--ink)]">
							<img src="/logo-light.svg" alt="NonUnicodeConverter Logo" class="logo-light w-5 h-5 rounded" />
							<img src="/logo-dark.svg" alt="NonUnicodeConverter Logo" class="logo-dark w-5 h-5 rounded" />
							<span>NonUnicodeConverter</span>
						</div>
						<p class="text-xs text-[var(--ink-secondary)] leading-relaxed">
							{t.footerDesc}
						</p>
					</div>

					<!-- Col 2: Quick Links -->
					<div class="space-y-2.5">
						<h4 class="font-semibold text-xs text-[var(--ink)] uppercase tracking-wider font-mono">{t.footerPages}</h4>
						<ul class="space-y-1.5 text-xs">
							<li><a href={lang === 'en' ? '/' : `/${lang}`} class="hover:text-[var(--ink)] transition-colors">{t.navConverter}</a></li>
							<li><a href={lang === 'en' ? '/how-to-use' : `/${lang}/how-to-use`} class="hover:text-[var(--ink)] transition-colors">{t.navHowToUse}</a></li>
							<li><a href={lang === 'en' ? '/about' : `/${lang}/about`} class="hover:text-[var(--ink)] transition-colors">{t.navAbout}</a></li>
							<li><a href={lang === 'en' ? '/download' : `/${lang}/download`} class="hover:text-[var(--ink)] transition-colors text-[var(--ink)] font-medium">{t.navDownloadApp}</a></li>
							<li><a href={lang === 'en' ? '/contact' : `/${lang}/contact`} class="hover:text-[var(--ink)] transition-colors">{t.navContact}</a></li>
						</ul>
					</div>

					<!-- Col 3: Legal & Trust -->
					<div class="space-y-2.5">
						<h4 class="font-semibold text-xs text-[var(--ink)] uppercase tracking-wider font-mono">{t.footerLegal}</h4>
						<ul class="space-y-1.5 text-xs">
							<li><a href={lang === 'en' ? '/privacy' : `/${lang}/privacy`} class="hover:text-[var(--ink)] transition-colors">{t.privacyTitle}</a></li>
							<li><a href={lang === 'en' ? '/terms' : `/${lang}/terms`} class="hover:text-[var(--ink)] transition-colors">{t.termsTitle}</a></li>
						</ul>
					</div>

					<!-- Col 4: Regional Language Paths & Specific Converters -->
					<div class="space-y-2.5">
						<h4 class="font-semibold text-xs text-[var(--ink)] uppercase tracking-wider font-mono">{t.footerConverters}</h4>
						<ul class="space-y-1.5 text-xs">
							<li><a href="/te/unicode-to-anu-converter" class="hover:text-[var(--ink)] transition-colors">Anu 7.0 & 6.0 (Telugu)</a></li>
							<li><a href="/hi/unicode-to-anu-neo-converter" class="hover:text-[var(--ink)] transition-colors">Anu Neo (Hindi)</a></li>
							<li><a href="/hi/unicode-to-kruti-dev-converter" class="hover:text-[var(--ink)] transition-colors">Kruti Dev (Hindi)</a></li>
							<li><a href="/ta/unicode-to-bamini-converter" class="hover:text-[var(--ink)] transition-colors">Bamini (Tamil)</a></li>
							<li><a href="/kn/unicode-to-nudi-converter" class="hover:text-[var(--ink)] transition-colors">Nudi (Kannada)</a></li>
							<li><a href="/ml/unicode-to-ism-ml-tt-converter" class="hover:text-[var(--ink)] transition-colors">ISM (Malayalam)</a></li>
						</ul>
					</div>
				</div>

				<!-- Footer Bottom Copyright Bar -->
				<div class="pt-6 border-t border-[var(--hairline)] flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left text-xs font-mono">
					<span id="footer-text">{t.footerCopyright}</span>
					<div class="flex items-center gap-4 text-[var(--ink-tertiary)]">
						<a href={lang === 'en' ? '/privacy' : `/${lang}/privacy`} class="hover:underline">Privacy</a>
						<span>•</span>
						<a href={lang === 'en' ? '/terms' : `/${lang}/terms`} class="hover:underline">Terms</a>
						<span>•</span>
						<a href={lang === 'en' ? '/contact' : `/${lang}/contact`} class="hover:underline">Contact</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			const themeToggleBtn = document.getElementById('theme-toggle-btn');
			themeToggleBtn?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});

			const langSelect = document.getElementById('lang-select') as HTMLSelectElement;
			langSelect?.addEventListener('change', (e) => {
				const selectedLang = (e.target as HTMLSelectElement).value;
				const targetPath = `/${selectedLang}`;
				window.location.href = targetPath;
			});
		</script>
		<!-- Canvas Mathematical Logic -->
		<script is:inline>
			const canvas = document.getElementById("fx");
			const ctx = canvas?.getContext("2d");
			let W, H, dpr;

			function resize(){
				if (!canvas) return;
				const r = canvas.parentElement.getBoundingClientRect();
				W = window.innerWidth;
				H = window.innerHeight;
				dpr = window.devicePixelRatio || 1;
				canvas.width = Math.round(W * dpr);
				canvas.height = Math.round(H * dpr);
				renderStaticCanvas();
			}
			window.addEventListener("resize", resize);

			function renderStaticCanvas(){
				if(!ctx || !canvas) return;

				const isLightMode = !document.documentElement.classList.contains('dark');

				ctx.resetTransform();
				ctx.clearRect(0, 0, canvas.width, canvas.height);
				ctx.scale(dpr, dpr);

				const cx = W * 0.5;
				const cy = -H * 0.12;

				const bgColor = isLightMode ? "#e6f0fa" : "#08090b";
				const cWhite = (alpha) => `rgba(255, 255, 255, ${alpha})`;
				const rColor = isLightMode ? 45 : 255;
				const gColor = isLightMode ? 85 : 255;
				const bColor = isLightMode ? 150 : 255;
				const cRay = (alpha) => `rgba(${rColor}, ${gColor}, ${bColor}, ${alpha})`;

				const coreAlpha1 = isLightMode ? 0.4 : 0.12;
				const coreAlpha2 = isLightMode ? 0.18 : 0.05;
				const sourceAlpha = isLightMode ? 0.65 : 0.85;

				const broadAlphaBase = isLightMode ? 0.035 : 0.09;
				const thinAlphaBase = isLightMode ? 0.02 : 0.035;

				ctx.fillStyle = bgColor;
				ctx.fillRect(0, 0, W, H);

				let bg = ctx.createRadialGradient(cx, cy, 0, cx, H * 0.45, H);
				bg.addColorStop(0, cWhite(coreAlpha1));
				bg.addColorStop(0.3, cWhite(coreAlpha2));
				bg.addColorStop(1, cWhite(0));
				ctx.fillStyle = bg;
				ctx.fillRect(0, 0, W, H);

				let source = ctx.createRadialGradient(cx, cy, 0, cx, cy, W * 0.2);
				source.addColorStop(0, cWhite(sourceAlpha));
				source.addColorStop(0.1, cWhite(sourceAlpha * 0.5));
				source.addColorStop(0.5, cWhite(sourceAlpha * 0.1));
				source.addColorStop(1, cWhite(0));
				ctx.fillStyle = source;
				ctx.fillRect(0, 0, W, H);

				// Broad Volumetric Soft Beams
				const broadRays = [];
				const numBroad = 16;
				for(let i=0; i<=numBroad; i++) {
					broadRays.push({ i: i, q: (i / numBroad) - 0.5 });
				}
				broadRays.push({ i: 1, q: -0.17, forceSway: 0 });

				broadRays.forEach(ray => {
					const { i, q, forceSway } = ray;
					const dist = Math.abs(q) * 2;
					const direction = q < 0 ? -1 : 1;
					const staticSway = forceSway !== undefined ? forceSway : Math.sin(i * 2.3) * W * 0.035 * direction;

					// Widened from 1.5 to 2.4
					const bottomX = cx + (q * W * 2.4) + staticSway;
					const topW = W * 0.025;
					const botW = W * (0.04 + dist * 0.02);

					const alpha = Math.max(0, broadAlphaBase - dist * (broadAlphaBase * 0.5));
					const blur = 10 + dist * 8;

					ctx.save();
					ctx.filter = `blur(${blur}px)`;
					ctx.beginPath();
					ctx.moveTo(cx - topW, cy); ctx.lineTo(cx + topW, cy);
					ctx.lineTo(bottomX + botW, H * 1.2); ctx.lineTo(bottomX - botW, H * 1.2);
					ctx.closePath();

					const grad = ctx.createLinearGradient(cx, cy, bottomX, H * 1.2);
					grad.addColorStop(0, cRay(alpha));
					grad.addColorStop(0.3, cRay(alpha * 0.6));
					grad.addColorStop(1, cRay(0));

					ctx.fillStyle = grad; ctx.fill(); ctx.restore();
				});

				// Sharp, Disjointed Partitions
				ctx.save();
				ctx.globalCompositeOperation = isLightMode ? "multiply" : "screen";
				const thinRays = [];
				const numThin = 26;
				for(let i=0; i<=numThin; i++) {
					thinRays.push({ i: i, q: (i / numThin) - 0.5 });
				}
				thinRays.push({ i: 1, q: -0.17, forceSway: 0 });

				thinRays.forEach(ray => {
					const { i, q, forceSway } = ray;
					const dist = Math.abs(q) * 2;
					const direction = q < 0 ? -1 : 1;
					const staticSway = forceSway !== undefined ? forceSway : Math.cos(i * 3.7) * W * 0.045 * direction;

					// Widened from 1.25 to 2.0
					const bottomX = cx + (q * W * 2.0) + staticSway;
					const topW = W * 0.008;
					const botW = W * (0.006 + (i%3===0 ? 0.008 : 0));

					const alpha = Math.max(0, thinAlphaBase - dist * (thinAlphaBase * 0.5));

					ctx.save();
					ctx.filter = "blur(2px)";
					ctx.beginPath();
					ctx.moveTo(cx - topW, cy); ctx.lineTo(cx + topW, cy);
					ctx.lineTo(bottomX + botW, H * 1.2); ctx.lineTo(bottomX - botW, H * 1.2);
					ctx.closePath();

					const grad = ctx.createLinearGradient(cx, cy, bottomX, H * 1.2);
					grad.addColorStop(0, cRay(alpha * 2.5));
					grad.addColorStop(0.2, cRay(alpha));
					grad.addColorStop(1, cRay(0));

					ctx.fillStyle = grad; ctx.fill(); ctx.restore();
				});
				ctx.restore();

				// Static Dust Particles
				for(let i=0; i<65; i++){
					const seed1 = i * 17.173;
					const seed2 = i * 23.345;
					const px = (Math.sin(seed1)*0.5+0.5) * W;
					const py = (Math.cos(seed2)*0.5+0.5) * H * 0.95;

					if(Math.abs(px - cx) < W * 0.45){
						const baseA = isLightMode ? 0.15 : 0.015;
						const alpha = baseA + (baseA * 1.5)*(1 - Math.abs(px - cx)/(W*0.45));
						ctx.fillStyle = cWhite(alpha);
						ctx.fillRect(px, py, isLightMode ? 1.5 : 1.2, isLightMode ? 1.5 : 1.2);
					}
				}

				// Vignette
				let v = ctx.createRadialGradient(cx, H*0.4, W*0.1, cx, H*0.5, W*0.9);
				v.addColorStop(0, "rgba(0,0,0,0)");
				if (isLightMode) {
					v.addColorStop(0.65, "rgba(45, 85, 150, 0.04)");
					v.addColorStop(1, "rgba(45, 85, 150, 0.18)");
				} else {
					v.addColorStop(0.65, "rgba(0,0,0,0.06)");
					v.addColorStop(1, "rgba(0,0,0,0.45)");
				}
				ctx.fillStyle = v; ctx.fillRect(0,0,W,H);
			}

			// Watch for theme changes specifically for this effect
			const observer = new MutationObserver((mutations) => {
				mutations.forEach((mutation) => {
					if (mutation.attributeName === 'class') {
						renderStaticCanvas();
					}
				});
			});
			observer.observe(document.documentElement, { attributes: true });

			document.fonts.ready.then(() => resize());
		</script>
	</body>
</html>
