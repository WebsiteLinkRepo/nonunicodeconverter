      const hasKannada = /[\u0C80-\u0CFF]/.test(val);
      const hasMalayalam = /[\u0D00-\u0D7F]/.test(val);
      const hasGujarati = /[\u0A80-\u0AFF]/.test(val);

      function detectDevanagariLanguage(text: string) {
        if (/[ळऱऴ]|र्‍|र‍्/.test(text)) return "marathi";
        const marathiWordSet = new Set(["आहे", "आहेत", "आहोत", "आहात", "नाही", "नाहीत", "होता", "होती", "होते", "होत्या", "असेल", "असेलच", "असून", "झाला", "झाली", "झाले", "झाल्या", "झालेलं", "माझा", "माझी", "माझे", "तुझा", "तुझी", "तुझे", "आमचा", "आमची", "आमचे", "तुमचा", "तुमची", "तुमचे", "त्याचा", "त्याची", "त्याचे", "त्यांचा", "त्यांची", "त्यांचे", "त्यांना", "त्यांच्या", "याच्या", "याची", "याचे", "यांचा", "यांची", "यांचे", "आपण", "स्वतः", "कसा", "कशी", "कसे", "कधी", "कुठे", "कशाला", "किती", "काय", "म्हणून", "म्हणाले", "म्हणाली", "म्हणाला", "म्हणतात", "आणि", "किंवा", "तसेच", "सुद्धा", "देखील", "केले", "केली", "केला", "केलेलं", "करून", "होऊन", "गेला", "गेली", "गेले", "पाहिजे", "करायचा", "करायची", "करायचे", "सांगितले", "सांगितला", "सांगितली"]);
        const hindiWordSet = new Set(["है", "हैं", "था", "थी", "थे", "हूँ", "हो", "नहीं", "होगा", "होगी", "होंगे", "होना", "होने", "हुआ", "हुई", "हुए", "मेरा", "मेरी", "मेरे", "तेरा", "तेरी", "तेरे", "हमारा", "हमारी", "हमारे", "आपका", "आपकी", "आपके", "उसका", "उसकी", "उसके", "उनका", "उनकी", "उनके", "उन्हें", "उन्हों", "उसने", "इन्होंने", "किसने", "किसका", "कैसा", "कैसी", "कैसे", "कब", "कहाँ", "क्यों", "कितना", "कितने", "कितनी", "क्या", "और", "या", "लेकिन", "परंतु", "भी", "किया", "किये", "किए", "करेगा", "करेगी", "करेंगे", "गया", "गई", "गए", "जाना", "आना", "सकता", "सकती", "सकते", "चाहिए", "बहुत", "अच्छा"]);
        let mScore = 0, hScore = 0;
        const words = text.split(/[\s,।!?.\(\)\[\]{}"\x27:;\\/+=_-]+/);
        for (const w of words) {
          if (marathiWordSet.has(w)) mScore += 3;
          if (hindiWordSet.has(w)) hScore += 3;
        }
        if (mScore > hScore && mScore > 0) return "marathi";
        if (hScore > mScore && hScore > 0) return "hindi";
        return null;
      }

      if (scriptSelect) {
        const oldScript = scriptSelect.value;
        if (hasDevanagari && !hasTelugu && !hasTamil && !hasKannada && !hasMalayalam && !hasGujarati) {
          const detected = detectDevanagariLanguage(val);
          if (detected === 'marathi') {
            scriptSelect.value = 'marathi';
          } else if (detected === 'hindi') {
            scriptSelect.value = 'hindi';
          } else if (oldScript !== 'hindi' && oldScript !== 'marathi') {
            scriptSelect.value = 'hindi';
          }
        }
        else if (hasTelugu && !hasDevanagari && !hasTamil && !hasKannada && !hasMalayalam && !hasGujarati) scriptSelect.value = 'telugu';
        else if (hasTamil && !hasDevanagari && !hasTelugu && !hasKannada && !hasMalayalam && !hasGujarati) scriptSelect.value = 'tamil';
        else if (hasKannada && !hasDevanagari && !hasTelugu && !hasTamil && !hasMalayalam && !hasGujarati) scriptSelect.value = 'kannada';
