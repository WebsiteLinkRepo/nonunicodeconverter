	  swapBtn?.addEventListener('click', () => {
    const currentInput = inputText.value;
    const currentOutput = outputText.value;

    if (currentOutput && currentOutput.trim().length > 0) {
      const isOutputUnicode = /[\u0A80-\u0AFF\u0C00-\u0C7F\u0900-\u097F]/.test(currentOutput);
      inputText.value = currentOutput;
      isManualReverse = !isOutputUnicode;
    } else if (currentInput && currentInput.trim().length > 0) {
      const isInputUnicode = /[\u0A80-\u0AFF\u0C00-\u0C7F\u0900-\u097F]/.test(currentInput);
      const currentReverse = isManualReverse !== null ? isManualReverse : !isInputUnicode;
      isManualReverse = !currentReverse;
    } else {
      isManualReverse = isManualReverse === null ? true : !isManualReverse;
    }

    swapBtn.classList.add('scale-105');
    setTimeout(() => swapBtn.classList.remove('scale-105'), 150);

    processConversion();
  });

  
  function activeFontNameLabel(): string {
    const fontVersionSelectEl = document.getElementById('font-version-select') as HTMLSelectElement;
    const exactFontSelectEl = document.getElementById('exact-font-select') as HTMLSelectElement;
    const exactFontSelectWrapper = document.getElementById('exact-font-select-wrapper') as HTMLDivElement;
    
    let baseFormat = 'Target Font';
    if (fontVersionSelectEl && fontVersionSelectEl.options.length > 0 && fontVersionSelectEl.selectedIndex >= 0) {
      baseFormat = fontVersionSelectEl.options[fontVersionSelectEl.selectedIndex].text;
    }
    
    if (exactFontSelectWrapper && !exactFontSelectWrapper.classList.contains('hidden') && exactFontSelectEl && exactFontSelectEl.options.length > 0 && exactFontSelectEl.selectedIndex >= 0) {
      const exactFont = exactFontSelectEl.options[exactFontSelectEl.selectedIndex].text;
      return `${baseFormat} (${exactFont})`;
    }
    
    return baseFormat;
  }


  // Initial call to set UI states
  const initScriptIsHindi = typeof scriptSelectEl !== 'undefined' && scriptSelectEl ? scriptSelectEl.value === 'hindi' : false;
  const useAltRaaVatthuInit = (altRaaVatthuChk && !initScriptIsHindi) ? altRaaVatthuChk.checked : false;
  const effectiveFontStyleInit = useAltRaaVatthuInit ? 'bapu' : selectedFontStyle;
  
  let initLegacyFontToApply = '"Mangal", system-ui, sans-serif';
  const initEncoding = fontVersionSelectEl ? fontVersionSelectEl.value : 'anu7';
  if (initEncoding === 'krutidev') initLegacyFontToApply = "'Kruti Dev 010', 'Kruti Dev', 'DevLys 010', sans-serif";
  else if (initEncoding === 'bamini') initLegacyFontToApply = "'Bamini', sans-serif";
  else if (initEncoding === 'nudi') initLegacyFontToApply = "'Nudi', sans-serif";
  else if (initEncoding === 'ism') initLegacyFontToApply = "'ML-TTKarthika', sans-serif";
  else if (initEncoding === 'shreelipi') initLegacyFontToApply = initScriptIsHindi ? "'SHREE-DEV7-4642', 'SHREE-DEV', sans-serif" : "'Shree-Tel-0908', 'SHREE-TEL', sans-serif";
  else if (initEncoding === 'shreelipitam') initLegacyFontToApply = "'SHREE-TAM7-0803', sans-serif";
  else if (initEncoding === 'shreelipimar') initLegacyFontToApply = "'SHREE-DEV-0708', sans-serif";
  else initLegacyFontToApply = fontStyles[effectiveFontStyleInit] || 'AnuPriyanka, Priyaanka';

  inputText.style.fontFamily = (inputText.value) ? initLegacyFontToApply : '"Mangal", system-ui, sans-serif';
  outputText.style.fontFamily = (outputText.value) ? initLegacyFontToApply : '"Mangal", system-ui, sans-serif';

  if (activeFontLabel) {
    activeFontLabel.textContent = activeFontNameLabel();
  }

  const cp1252: Record<number, number> = {
    0x20AC: 0x80, 0x201A: 0x82, 0x0192: 0x83, 0x201E: 0x84, 0x2026: 0x85, 0x2020: 0x86, 0x2021: 0x87,
    0x02C6: 0x88, 0x2030: 0x89, 0x0160: 0x8A, 0x2039: 0x8B, 0x0152: 0x8C, 0x017D: 0x8E, 0x2018: 0x91,
    0x2019: 0x92, 0x201C: 0x93, 0x201D: 0x94, 0x2022: 0x95, 0x2013: 0x96, 0x2014: 0x97, 0x02DC: 0x98,
    0x2122: 0x99, 0x0161: 0x9A, 0x203A: 0x9B, 0x0153: 0x9C, 0x017E: 0x9E, 0x0178: 0x9F
  };

  function pagemakerDownconvert(text: string): string {
    return text.replace(/[\uF000-\uF0FF]/g, match => {
      const code = match.charCodeAt(0) - 0xF000;
      if (code >= 128 && code <= 159) {
        const cp1252toUni: Record<number, number> = {
          128: 0x20AC, 129: 0x0081, 130: 0x201A, 131: 0x0192,
          132: 0x201E, 133: 0x2026, 134: 0x2020, 135: 0x2021,
          136: 0x02C6, 137: 0x2030, 138: 0x0160, 139: 0x2039,
          140: 0x0152, 141: 0x008D, 142: 0x017D, 143: 0x008F,
          144: 0x0090, 145: 0x2018, 146: 0x2019, 147: 0x201C,
          148: 0x201D, 149: 0x2022, 150: 0x2013, 151: 0x2014,
          152: 0x02DC, 153: 0x2122, 154: 0x0161, 155: 0x203A,
          156: 0x0153, 157: 0x009D, 158: 0x017E, 159: 0x0178
        };
        return String.fromCharCode(cp1252toUni[code]);
      }
      return String.fromCharCode(code);
    });
  }

  function charToWin1252(char: string): number {
    const code = char.charCodeAt(0);
    
    // Down-convert Private Use Area (PUA) characters to raw byte codes for Symbol fonts
    if (code >= 0xF000 && code <= 0xF0FF) {
      return code - 0xF000;
    }
    
    if (cp1252[code]) return cp1252[code];
    if (code <= 255) return code;
    return 63; // '?' fallback
  }

  function generateRTF(text: string, fontName: string): string {
    let rtf = `{\\rtf1\\ansi\\ansicpg1252\\deff0{\\fonttbl{\\f0\\fnil\\fcharset2 ${fontName};}}\n\\viewkind4\\uc1\\pard\\lang1033\\kerning0\\f0\\fs24 `;
    for (let i = 0; i < text.length; i++) {
      const char = text[i];
      if (char === '\n') {
        rtf += '\\par\n';
      } else if (char === '\r') {
        // ignore
      } else if (char === '\\') {
        rtf += '\\\\';
      } else if (char === '{') {
        rtf += '\\{';
      } else if (char === '}') {
        rtf += '\\}';
      } else {
        const uniCode = char.charCodeAt(0);
        const winCode = charToWin1252(char);
        if (uniCode > 127 || uniCode < 32) {
          // Use pure ANSI hex escapes (\'hh) to avoid PageMaker RTF parser bugs with Unicode \u tags
          rtf += `\\` + `'` + winCode.toString(16).padStart(2, '0');
        } else {
          rtf += char;
        }
      }
    }
    rtf += '}';
    return rtf;
  }

  function writeToClipboard(val: string, fontName: string, isOutputUnicode: boolean): boolean {
    let success = false;
    
    // Core payload:
    // 1. Plain text: Down-converted to ANSI bytes (Š) for PageMaker 7.0.
    // 2. HTML: PUA wrapped in <font> and <span> for MS Word and LibreOffice.
    // 3. RTF: PUA in Unicode \uN for WordPad and legacy RTF parsers.
    const plainText = isOutputUnicode ? val : pagemakerDownconvert(val);
    
    let htmlText = val;
    let rtfText = val;
    if (!isOutputUnicode) {
      const htmlEscaped = val.replace(/\n/g, '<br>');
      // MS Word natively respects <font face> for symbol fonts over CSS
      htmlText = `<span lang="en-US" dir="ltr" style="font-family: '${fontName}';">${htmlEscaped}</span>`;
      rtfText = generateRTF(val, fontName);
    }

    const listener = (e: ClipboardEvent) => {
      e.preventDefault();
      if (e.clipboardData) {
        e.clipboardData.setData('text/plain', plainText);
        if (!isOutputUnicode) {
          e.clipboardData.setData('text/html', htmlText);
          e.clipboardData.setData('text/rtf', rtfText);
          e.clipboardData.setData('application/rtf', rtfText);
          e.clipboardData.setData('text/richtext', rtfText);
          e.clipboardData.setData('application/x-rtf', rtfText);
        }
      }
    };

    // 1. Try synchronous execCommand first (crucial for injecting text/rtf on modern browsers)
    document.addEventListener('copy', listener);
    try {
      success = document.execCommand('copy');
    } catch (err) {
      success = false;
    }
    document.removeEventListener('copy', listener);

    // 2. Fallback to async ClipboardItem API (for browsers blocking execCommand)
    if (!success && typeof ClipboardItem !== 'undefined' && navigator.clipboard && navigator.clipboard.write) {
      try {
        const items: Record<string, Blob> = {
          'text/plain': new Blob([plainText], { type: 'text/plain' })
        };
        if (!isOutputUnicode) {
          items['text/html'] = new Blob([htmlText], { type: 'text/html' });
        }
        navigator.clipboard.write([new ClipboardItem(items)]);
        success = true;
      } catch (e) {}
    }

    // 3. Ultimate fallback
    if (!success && navigator.clipboard && navigator.clipboard.writeText) {
      try {
        navigator.clipboard.writeText(plainText);
        success = true;
      } catch (err) {}
    }

    return success;
  }

  // Copy Output Handler
  copyBtn.addEventListener('click', async () => {
    let val = outputText.dataset.realValue || outputText.value;
    const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
    if (!val) {
      inputText.focus();
      return;
    }

    const isOutputUnicode = /[\u0A80-\u0AFF\u0C00-\u0C7F\u0900-\u097F]/.test(val);
    
    let exactFontTel = '';
    if (document.getElementById('exact-font-select-wrapper') && !document.getElementById('exact-font-select-wrapper').classList.contains('hidden')) {
        exactFontTel = (document.getElementById('exact-font-select') as HTMLSelectElement)?.value || '';
    }
    let fontName = exactFontTel || 'Priyaanka'; // Ensure Word sees the original font name, default Priyaanka if exact unset

    const currentScript = (document.getElementById('script-select') as HTMLSelectElement)?.value || 'telugu';
    const currentFormat = (document.getElementById('font-version-select') as HTMLSelectElement)?.value || 'anu7';
    
    if (currentScript === 'telugu' && currentFormat === 'shreelipi') {
      fontName = 'Shree-Tel-0908';
    } else if (currentScript === 'hindi') {
      
      let exactFont = '';
      if (document.getElementById('exact-font-select-wrapper') && !document.getElementById('exact-font-select-wrapper').classList.contains('hidden')) {
          exactFont = (document.getElementById('exact-font-select') as HTMLSelectElement)?.value || '';
      }
      fontName = currentFormat === 'krutidev' ? 'Kruti Dev 010' : (currentFormat === 'shreelipi' ? 'SHREE-DEV7-4642' : (exactFont || 'AnuNEOGANBO'));

    } else if (currentScript === 'tamil') {
      fontName = currentFormat === 'bamini' ? 'Bamini' : (currentFormat === 'shreelipitam' ? 'SHREE-TAM7-0803' : 'Padmini');
    } else if (currentScript === 'kannada') {
      fontName = currentFormat === 'nudi' ? 'Nudi 01 e' : 'Din';
    } else if (currentScript === 'malayalam') {
      fontName = 'ML-TTKarthika';
    } else if (currentScript === 'marathi') {
      fontName = 'SHREE-DEV-0708';
    } else if (currentScript === 'gujarati') {
      fontName = 'Hari';
    }
    const success = writeToClipboard(val, fontName, isOutputUnicode);

    if (success) {
      copyBtnText.textContent = t.copiedBtn;
      copyBtn.classList.remove('bg-[var(--ink)]');
      copyBtn.classList.add('bg-emerald-600', 'text-white');
      
      setTimeout(() => {
        copyBtnText.textContent = t.copyBtn;
        copyBtn.classList.remove('bg-emerald-600', 'text-white');
        copyBtn.classList.add('bg-[var(--ink)]');
      }, 2000);
    }
  });

  // Download Output Handler (.txt)
  downloadBtn?.addEventListener('click', () => {
    let text = outputText.value;
    if (!text) {
      inputText.focus();
      return;
    }
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `converted-${selectedFontStyle}-${Date.now()}.txt`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // Paste Handler
  pasteBtn.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text) {
        const start = inputText.selectionStart;
        const end = inputText.selectionEnd;
        inputText.value = inputText.value.substring(0, start) + text + inputText.value.substring(end);
        inputText.selectionStart = inputText.selectionEnd = start + text.length;
        inputText.focus();
        isManualReverse = null;
        processConversion();
      }
    } catch {
      inputText.focus();
    }
  });

  // Clear Handler
  clearBtn.addEventListener('click', () => {
    isManualReverse = null;
    inputText.value = '';
    processConversion();
    inputText.focus();
  });

  // Remove English Handler
  const removeEnglishBtn = document.getElementById('remove-english-btn');
  if (removeEnglishBtn) {
    removeEnglishBtn.addEventListener('click', () => {
      // Remove A-Z, a-z
      inputText.value = inputText.value.replace(/[A-Za-z]/g, '');
      processConversion();
    });
  }
</script>
