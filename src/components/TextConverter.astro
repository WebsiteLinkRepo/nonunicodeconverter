  let initLegacyFontToApply = '"Mangal", system-ui, sans-serif';
  const initEncoding = fontVersionSelectEl ? fontVersionSelectEl.value : 'anu7';
  if (initEncoding === 'krutidev') initLegacyFontToApply = "'Kruti Dev 010', 'Kruti Dev', 'DevLys 010', sans-serif";
  else if (initEncoding === 'bamini') initLegacyFontToApply = "'Bamini', sans-serif";
  else if (initEncoding === 'nudi') initLegacyFontToApply = "'Nudi', sans-serif";
  else if (initEncoding === 'ism') initLegacyFontToApply = "'ML-TTKarthika', sans-serif";
  else if (initEncoding === 'shreelipi') initLegacyFontToApply = initScriptIsHindi ? "'SHREE-DEV7-4642', 'SHREE-DEV', sans-serif" : "'Shree-Tel-0908', 'SHREE-TEL', sans-serif";
  else if (initEncoding === 'shreelipitam') initLegacyFontToApply = "'SHREE-TAM7-0803', sans-serif";
  else if (initEncoding === 'shreelipimar') initLegacyFontToApply = "'SHREE-DEV-0708', sans-serif";
  else initLegacyFontToApply = fontStyles[effectiveFontStyleInit] || 'AnuPriyanka, Priyaanka';

  inputText.style.fontFamily = (inputText.value) ? initLegacyFontToApply : '"Mangal", system-ui, sans-serif';
  outputText.style.fontFamily = (outputText.value) ? initLegacyFontToApply : '"Mangal", system-ui, sans-serif';

  if (activeFontLabel) {
