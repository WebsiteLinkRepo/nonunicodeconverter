      gujarati: "Paste Gujarati Unicode text here... (e.g. નમસ્કાર! ગુજરાતી ભાષા ખૂબ જ સુંદર છે.)"
    };

    const scriptNames: Record<string, string> = {
      hindi: 'Hindi', tamil: 'Tamil', kannada: 'Kannada', malayalam: 'Malayalam', telugu: 'Telugu', marathi: 'Marathi', gujarati: 'Gujarati'
    };

    const allSampleBtns = [sampleTeluguBtn, sampleHindiBtn, sampleTamilBtn, sampleKannadaBtn, sampleMalayalamBtn, sampleMarathiBtn, sampleGujaratiBtn];
    allSampleBtns.forEach(btn => btn?.classList.add('hidden'));

    if (script === 'telugu') {
      sampleTeluguBtn?.classList.remove('hidden');
      if (altRaaVatthuWrapper) altRaaVatthuWrapper.style.display = 'flex';
    } else if (script === 'hindi') {
      sampleHindiBtn?.classList.remove('hidden');
      if (altRaaVatthuWrapper) altRaaVatthuWrapper.style.display = 'none';
    } else if (script === 'tamil') {
      sampleTamilBtn?.classList.remove('hidden');
      if (altRaaVatthuWrapper) altRaaVatthuWrapper.style.display = 'none';
    } else if (script === 'kannada') {
      sampleKannadaBtn?.classList.remove('hidden');
      if (altRaaVatthuWrapper) altRaaVatthuWrapper.style.display = 'none';
    } else if (script === 'malayalam') {
      sampleMalayalamBtn?.classList.remove('hidden');
      if (altRaaVatthuWrapper) altRaaVatthuWrapper.style.display = 'none';
    } else if (script === 'marathi') {
      sampleMarathiBtn?.classList.remove('hidden');
      if (altRaaVatthuWrapper) altRaaVatthuWrapper.style.display = 'none';
    } else if (script === 'gujarati') {
      sampleGujaratiBtn?.classList.remove('hidden');
      if (altRaaVatthuWrapper) altRaaVatthuWrapper.style.display = 'none';
    } else {
      if (altRaaVatthuWrapper) altRaaVatthuWrapper.style.display = 'none';
    }
    
    const scriptNameUpper = scriptNames[script].toUpperCase();
    const fontLabelUpper = activeFontNameLabel().toUpperCase();

    // Determine direction early for UI labels
    let reverse = false;
    if (val) {
      const hasTeluguChar = /[\u0C00-\u0C7F]/.test(val);
      const hasDevanagariChar = /[\u0900-\u097F]/.test(val);
      const hasTamilChar = /[\u0B80-\u0BFF]/.test(val);
      const hasKannadaChar = /[\u0C80-\u0CFF]/.test(val);
      const hasMalayalamChar = /[\u0D00-\u0D7F]/.test(val);
      const hasGujaratiChar = /[\u0A80-\u0AFF]/.test(val);
      const isUnicodeInput = hasTeluguChar || hasDevanagariChar || hasTamilChar || hasKannadaChar || hasMalayalamChar || hasGujaratiChar;
      reverse = isManualReverse !== null ? isManualReverse : !isUnicodeInput;
