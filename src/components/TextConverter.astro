---
import { AVAILABLE_FONTS } from '../utils/mappings';
import { TRANSLATIONS, type Language } from '../utils/i18n';

interface Props {
  lang?: Language;
  defaultScript?: string;
  defaultFormat?: string;
}

const { lang = 'en', defaultScript, defaultFormat } = Astro.props;
const t = TRANSLATIONS[lang] || TRANSLATIONS.en;
const defaultFont = 'anu7';
---

<div id="converter-root" class="w-full max-w-4xl mx-auto space-y-4" data-lang={lang} data-default-font={defaultFont} data-default-script={defaultScript || ''} data-default-format={defaultFormat || ''}>
  <!-- Header / Smart Auto Status Badge -->
  <div class="flex justify-end gap-3 rounded-xl">
    <div class="text-xs font-mono text-[var(--ink-secondary)] flex items-center justify-center sm:justify-start gap-1.5 bg-[var(--canvas)] border border-[var(--hairline)] px-3 py-2 rounded-full shadow-2xs">
      <span class="w-2 h-2 rounded-full bg-[var(--ink)] animate-pulse flex-shrink-0"></span>
      <span id="auto-status" class="truncate">Auto-detecting text format</span>
    </div>
  </div>

  <!-- DTP Helper Options Bar (Uniform Checkboxes) -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 px-3.5 py-2.5 bg-[var(--canvas-soft-2)] border border-[var(--hairline)] rounded-xl text-xs">
    <div class="flex flex-wrap items-center gap-3 sm:gap-4 w-full sm:w-auto">
      
      
      <!-- Script Selector -->
      <div class="flex items-center gap-2 font-medium text-[var(--ink-secondary)]">
        <label for="script-select" class="text-xs">Language:</label>
        <div class="relative">
          <select id="script-select" class="appearance-none bg-[var(--canvas)] border border-[var(--hairline)] rounded-md pl-2.5 pr-8 py-1.5 text-xs font-semibold text-[var(--ink)] focus:outline-none focus:ring-2 focus:ring-[var(--ink)] focus:border-transparent cursor-pointer shadow-2xs hover:border-[var(--ink-secondary)] transition-colors min-w-[90px]">
            <option value="telugu">Telugu</option>
            <option value="hindi">Hindi</option>
            <option value="tamil">Tamil</option>
            <option value="kannada">Kannada</option>
            <option value="malayalam">Malayalam</option>
            <option value="marathi">Marathi</option>
            <option value="gujarati">Gujarati</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-[var(--ink-tertiary)]">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>

      <!-- Font Version Selector -->
      <div class="flex items-center gap-2 font-medium text-[var(--ink-secondary)]">
        <label for="font-version-select" class="text-xs">Format:</label>
        <div class="relative">
          <select id="font-version-select" class="appearance-none bg-[var(--canvas)] border border-[var(--hairline)] rounded-md pl-2.5 pr-8 py-1.5 text-xs font-semibold text-[var(--ink)] focus:outline-none focus:ring-2 focus:ring-[var(--ink)] focus:border-transparent cursor-pointer shadow-2xs hover:border-[var(--ink-secondary)] transition-colors min-w-[90px]">
            <!-- Populated dynamically via JS -->
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-[var(--ink-tertiary)]">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>

      <!-- Specific Font Selector (Driven by Format/Script) -->
      <div id="exact-font-select-wrapper" class="hidden items-center gap-2 font-medium text-[var(--ink-secondary)] ml-0 sm:ml-2 relative group/fontdrop">
        <label for="exact-font-select" class="text-xs">Font:</label>
        <div class="relative">
          <select id="exact-font-select" class="appearance-none bg-[var(--canvas)] border border-[var(--hairline)] rounded-md pl-2.5 pr-8 py-1.5 text-xs font-semibold text-[var(--ink)] focus:outline-none focus:ring-2 focus:ring-[var(--ink)] focus:border-transparent cursor-pointer max-w-[200px] truncate shadow-2xs hover:border-[var(--ink-secondary)] transition-colors">
            <!-- Populated dynamically via JS -->
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-[var(--ink-tertiary)]">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
        <!-- Hover Explanation for Font Dropdown -->
        <div id="disabled-font-tooltip" class="absolute top-full left-0 mt-2 w-56 bg-[#2D3039] border border-[#40434F] rounded shadow-lg text-[11.5px] text-gray-200 p-2 opacity-0 invisible transition-opacity z-50 text-left pointer-events-none group-hover/fontdrop:opacity-100 group-hover/fontdrop:visible hidden">
          <div class="absolute -top-1 left-4 w-2 h-2 bg-[#2D3039] border-t border-l border-[#40434F] rotate-45"></div>
          {t.tooltipExactFont}
        </div>
      </div>


      <!-- Clean Extra Lines Checkbox -->
      <label class="flex items-center gap-2 cursor-pointer font-medium text-[var(--ink-secondary)] hover:text-[var(--ink)] touch-target py-1">
        <div class="relative flex items-center">
          <input id="clean-spaces-chk" type="checkbox" class="sr-only peer" />
          <div class="w-7 h-4 bg-[var(--hairline-strong)] opacity-50 peer-checked:opacity-100 rounded-full peer peer-checked:after:translate-x-3 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-[var(--canvas)] after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-[var(--ink)]"></div>
        </div>
        <span id="label-clean-spaces">Clean Linebreaks</span>
      </label>



      <!-- Alt Raa Vatthu Checkbox -->
      <label id="alt-raa-vatthu-wrapper" class="flex items-center gap-2 cursor-pointer font-medium text-[var(--ink-secondary)] hover:text-[var(--ink)] touch-target py-1 relative group">
        <div class="relative flex items-center">
          <input id="alt-raa-vatthu-chk" type="checkbox" class="sr-only peer" />
          <div class="w-7 h-4 bg-[var(--hairline-strong)] opacity-50 peer-checked:opacity-100 rounded-full peer peer-checked:after:translate-x-3 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-[var(--canvas)] after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-[var(--ink)]"></div>
        </div>
        <span id="label-alt-raa-vatthu" class="flex items-center gap-1.5">
          {t.altRaaVatthuLabel}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--ink-tertiary)] group-hover:text-[var(--ink)] transition-colors"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        </span>
        
        <!-- Tooltip -->
        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-72 max-w-[90vw] bg-[#1E2028] border border-[#3A3D4A] rounded-lg shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 text-sm cursor-default">
          <!-- Tooltip arrow -->
          <div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-[#1E2028] border-b border-r border-[#3A3D4A] rotate-45"></div>
          
          <div class="relative p-4 z-10 rounded-lg bg-[#1E2028]">
            <div class="flex items-start justify-between gap-2 mb-3 border-b border-[#3A3D4A] pb-3">
              <p class="font-semibold leading-tight text-white text-[13px]">{t.tooltipAltRaaTitle}</p>
              
              <!-- Nested "Why?" question mark -->
              <div class="relative group/why cursor-help shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 hover:text-white transition-colors"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                <!-- Nested explanation tooltip -->
                <div class="absolute top-full right-0 mt-2 w-48 p-2.5 bg-[#2D3039] border border-[#40434F] rounded shadow-lg text-[11.5px] text-gray-200 leading-snug opacity-0 invisible group-hover/why:opacity-100 group-hover/why:visible transition-opacity text-left z-20">
                  <div class="absolute -top-1 right-1.5 w-2 h-2 bg-[#2D3039] border-t border-l border-[#40434F] rotate-45"></div>
                  {t.tooltipAltRaaWhy}
                </div>
              </div>
            </div>
            
            <ul class="list-disc pl-4 space-y-1 text-gray-300 max-h-48 overflow-y-auto custom-scrollbar text-xs">
              <li>Aaradhana</li>
              <li>Amrutha</li>
              <li>Bapu Bold</li>
              <li>Bapu Brush</li>
              <li>Bapu Script</li>
              <li>Brahma Script</li>
              <li>Chandra Script</li>
              <li>Kusuma</li>
              <li>Maanasa</li>
              <li>Madhubala</li>
              <li>Ramana Brush Regular</li>
              <li>Ramana Script Regular</li>
              <li>Ramana Script Medium Regular</li>
              <li>Subhadra Regular</li>
            </ul>
          </div>
        </div>
      </label>


      
      <!-- Auto-copy Checkbox -->
      <label class="flex items-center gap-2 cursor-pointer font-medium text-[var(--ink-secondary)] hover:text-[var(--ink)] touch-target py-1">
        <div class="relative flex items-center">
          <input id="auto-copy-chk" type="checkbox" class="sr-only peer" checked />
          <div class="w-7 h-4 bg-[var(--hairline-strong)] opacity-50 peer-checked:opacity-100 rounded-full peer peer-checked:after:translate-x-3 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-[var(--canvas)] after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-[var(--ink)]"></div>
        </div>
        <span id="label-auto-copy">Auto-copy Output</span>
      </label>
    </div>

    <!-- Preset Sample Buttons -->
    <div class="flex items-center gap-1.5 w-full sm:w-auto justify-end border-t sm:border-t-0 border-[var(--hairline)] pt-2 sm:pt-0">
      <span class="text-[11px] font-mono text-[var(--ink-tertiary)] inline">Samples:</span>
      <button 
        id="sample-telugu-btn" 
        type="button" 
        class="px-2.5 py-1 text-[11px] font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors cursor-pointer touch-target shadow-2xs"
      >
        Telugu Unicode
      </button>
      <button 
        id="sample-hindi-btn" 
        type="button" 
        class="hidden px-2.5 py-1 text-[11px] font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors cursor-pointer touch-target shadow-2xs"
      >
        Hindi Unicode
      </button>
      <button 
        id="sample-tamil-btn" 
        type="button" 
        class="hidden px-2.5 py-1 text-[11px] font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors cursor-pointer touch-target shadow-2xs"
      >
        Tamil Unicode
      </button>
      <button 
        id="sample-kannada-btn" 
        type="button" 
        class="hidden px-2.5 py-1 text-[11px] font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors cursor-pointer touch-target shadow-2xs"
      >
        Kannada Unicode
      </button>
      <button
        id="sample-malayalam-btn"
        type="button"
        class="hidden px-2.5 py-1 text-[11px] font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors cursor-pointer touch-target shadow-2xs"
      >
        Malayalam Unicode
      </button>
      <button
        id="sample-marathi-btn"
        type="button"
        class="hidden px-2.5 py-1 text-[11px] font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors cursor-pointer touch-target shadow-2xs"
      >
        Marathi Unicode
      </button>
      <button
        id="sample-gujarati-btn"
        type="button"
        class="hidden px-2.5 py-1 text-[11px] font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors cursor-pointer touch-target shadow-2xs"
      >
        Gujarati Unicode
      </button>
    </div>
  </div>

  <!-- Dual Text Boxes -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Unicode / Text Input Box -->
    <div class="flex flex-col bg-[var(--card-bg)] border border-[var(--hairline)] rounded-xl overflow-hidden focus-within:border-[var(--hairline-strong)] focus-within:ring-1 focus-within:ring-[var(--ink)] transition-colors">
      <div class="flex items-center justify-between px-3.5 py-2.5 bg-[var(--canvas-soft)] border-b border-[var(--hairline)]">
        <span id="input-box-title" class="font-semibold text-xs uppercase tracking-wider text-[var(--ink)] flex items-center gap-1.5">
          UNICODE TEXT INPUT
        </span>
        <div class="flex items-center gap-1.5 sm:gap-2">
          <button 
            id="swap-btn" 
            type="button" 
            title="Swap input and output text (⇄ Reverse Conversion)"
            class="px-2 py-1.5 text-xs font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink)] hover:bg-[var(--canvas-soft-2)] active:scale-95 transition-all cursor-pointer touch-target flex items-center gap-1"
          >
            <span>⇄ Swap</span>
          </button>
          
          <button 
            id="paste-btn" 
            type="button" 
            class="px-2.5 py-1.5 text-xs font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink)] hover:bg-[var(--canvas-soft-2)] active:scale-95 transition-all cursor-pointer touch-target"
          >
            Paste Text
          </button>
          
          <button 
            id="remove-english-btn" 
            type="button" 
            title="Remove all English characters (A-Z, a-z)"
            class="px-2 py-1.5 text-xs font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-red-600 hover:border-red-200 transition-all cursor-pointer touch-target"
          >
            Clean English
          </button>
          
          <button 
            id="clear-btn" 
            type="button" 
            class="px-2 py-1.5 text-xs font-medium rounded-md bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink-secondary)] hover:text-red-600 hover:border-red-200 transition-colors cursor-pointer touch-target"
          >
            Clear All
          </button>
        </div>
      </div>
      <textarea
        id="input-text"
        spellcheck="false"
        placeholder="Paste Unicode text here... (e.g. తెలుగు / हिंदी నాన్-యూనికోడ్)"
        class="w-full h-48 sm:h-64 md:h-72 p-3.5 sm:p-4 bg-transparent text-[var(--ink)] text-sm sm:text-base leading-relaxed border-none resize-y focus:outline-none focus:ring-0"
        
      ></textarea>
    </div>

    <!-- Output Box & Controls -->
    <div class="flex flex-col bg-[var(--card-bg)] border border-[var(--hairline)] rounded-xl overflow-hidden transition-colors">
      <div class="flex items-center justify-between px-3.5 py-2.5 bg-[var(--canvas-soft)] border-b border-[var(--hairline)]">
        <span class="font-semibold text-xs uppercase tracking-wider text-[var(--ink)] truncate max-w-[180px] sm:max-w-none">
          <span id="output-box-title">NON-UNICODE OUTPUT</span>
        </span>
        
        <div class="flex items-center gap-2 flex-shrink-0">
          <!-- Text Zoom Controls (A- / A+) -->
          <div class="flex items-center gap-1 border border-[var(--hairline)] rounded-md bg-[var(--canvas)] px-1.5 py-0.5 text-xs font-mono">
            <button id="zoom-out-btn" type="button" class="px-1 py-0.5 hover:text-[var(--ink)] text-[var(--ink-secondary)] font-bold cursor-pointer touch-target" title="Decrease Font Size">A-</button>
            <span class="text-[var(--hairline-strong)]">|</span>
            <button id="zoom-in-btn" type="button" class="px-1 py-0.5 hover:text-[var(--ink)] text-[var(--ink-secondary)] font-bold cursor-pointer touch-target" title="Increase Font Size">A+</button>
          </div>
          <span id="char-count" class="text-xs font-mono text-[var(--ink-tertiary)]">0 chars</span>
        </div>
      </div>

      <textarea
        id="output-text"
        readonly
        spellcheck="false"
        placeholder="Converted legacy font text will appear here automatically..."
        class="w-full h-48 sm:h-64 md:h-72 p-3.5 sm:p-4 bg-transparent text-[var(--ink)] text-sm sm:text-base leading-relaxed border-none resize-y focus:outline-none focus:ring-0"
        
      ></textarea>

      <!-- Action Toolbar (Download .txt & Copy Button) -->
      <div class="p-3 bg-[var(--canvas-soft)] border-t border-[var(--hairline)] flex flex-col sm:flex-row gap-2">
        <!-- Download .txt File Button -->
        <button 
          id="download-btn" 
          type="button" 
          class="w-full sm:w-auto py-3 sm:py-2.5 px-3.5 rounded-lg bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink)] font-semibold text-xs flex items-center justify-center gap-1.5 hover:bg-[var(--canvas-soft-2)] active:scale-[0.98] transition-all cursor-pointer touch-target min-h-[44px] sm:min-h-0"
          title="Save output as a text file"
        >
          <svg class="w-4 h-4 text-[var(--ink-secondary)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span id="download-btn-text">Download .txt</span>
        </button>

        <!-- Massive Copy Button -->
        <button 
          id="copy-btn" 
          type="button" 
          class="w-full sm:flex-1 py-3 sm:py-2.5 px-4 rounded-lg bg-[var(--ink)] text-[var(--canvas)] font-bold text-xs flex items-center justify-center gap-2 hover:opacity-90 active:scale-[0.99] transition-all cursor-pointer uppercase tracking-wide touch-target min-h-[44px] sm:min-h-0"
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-btn-text">COPY OUTPUT</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Recents / History Drawer -->
  <div id="history-container" class="hidden bg-[var(--canvas-soft)] border border-[var(--hairline)] rounded-xl p-3 shadow-2xs space-y-2">
    <div class="flex items-center justify-between">
      <span id="history-title" class="text-xs font-semibold text-[var(--ink-secondary)] uppercase tracking-wide">Recent Conversions</span>
      <button id="clear-history-btn" type="button" class="text-[11px] text-[var(--ink-tertiary)] hover:text-red-500 transition-colors cursor-pointer">Clear History</button>
    </div>
    <div id="history-list" class="space-y-1.5 max-h-36 overflow-y-auto pr-1"></div>
  </div>

  <!-- Bottom Stats Bar -->
  <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 bg-[var(--canvas-soft)] border border-[var(--hairline)] rounded-lg text-[11px] font-mono text-[var(--ink-secondary)]">
    <div class="flex items-center gap-3">
      <span>Lines: <strong id="lines-stat" class="text-[var(--ink)]">0</strong></span>
      <span>•</span>
      <span>Words: <strong id="words-stat" class="text-[var(--ink)]">0</strong></span>
    </div>
  </div>
</div>

<!-- Client Logic & i18n Controller -->

    <!-- JS i18n data -->
    <div id="i18n-data" class="hidden" 
      data-disabled={t.tooltipDisabled}
      data-uncheck={t.tooltipUncheckAlt}
      data-check={t.tooltipCheckAlt}
      data-exact={t.tooltipExactFont}>
    </div>

  <script>
  import { convertText } from '../utils/converter';
  import { upconvertFromANSI } from '../utils/pua';
  import type { FontEncoding } from '../utils/mappings';
  import { TRANSLATIONS, type Language } from '../utils/i18n';

  interface HistoryItem {
    id: string;
    input: string;
    output: string;
    font: string;
    timestamp: number;
  }

  const rootEl = document.getElementById('converter-root') as HTMLDivElement;
  let currentLang: Language = (rootEl?.dataset.lang as Language) || 'en';
  let selectedFontStyle = 'priyanka';
  let currentFontSize = 16;
  let historyItems: HistoryItem[] = [];
  let isManualReverse: boolean | null = null;

  const fontStyles: Record<string, string> = {
    priyanka: 'AnuPriyanka, Priyaanka',
    anupama: 'AnuAnupama, Anupama',
    subhalekha: 'AnuSubhalekha, Subhalekha',
    bapu: 'AnuBapu, Bapu',
    ramana: 'AnuRamana, Ramana',
    gowthami: 'AnuGowthami, Gowthami'
  };

  const langSelect = document.getElementById('lang-select') as HTMLSelectElement;
  const logoTitleText = document.getElementById('logo-title-text') as HTMLSpanElement;
  const pageTitle = document.getElementById('page-title') as HTMLHeadingElement;
  const pageSubtitle = document.getElementById('page-subtitle') as HTMLParagraphElement;
  const labelSelectFont = document.getElementById('label-select-font') as HTMLSpanElement;
  const autoStatus = document.getElementById('auto-status') as HTMLSpanElement;

  const labelCleanSpaces = document.getElementById('label-clean-spaces') as HTMLSpanElement;

  const labelAltRaaVatthu = document.getElementById('label-alt-raa-vatthu') as HTMLSpanElement;
  const altRaaVatthuWrapper = document.getElementById('alt-raa-vatthu-wrapper') as HTMLLabelElement;

  const fontTabs = document.querySelectorAll<HTMLButtonElement>('.font-tab');
  const activeFontLabel = document.getElementById('active-font-label') as HTMLSpanElement;
  const inputBoxTitle = document.getElementById('input-box-title') as HTMLSpanElement;
  const outputBoxTitle = document.getElementById('output-box-title') as HTMLSpanElement;
  
  const inputText = document.getElementById('input-text') as HTMLTextAreaElement;
  const outputText = document.getElementById('output-text') as HTMLTextAreaElement;
  const charCount = document.getElementById('char-count') as HTMLSpanElement;

  const cleanSpacesChk = document.getElementById('clean-spaces-chk') as HTMLInputElement;

  const altRaaVatthuChk = document.getElementById('alt-raa-vatthu-chk') as HTMLInputElement;
  
  const zoomInBtn = document.getElementById('zoom-in-btn') as HTMLButtonElement;
  const zoomOutBtn = document.getElementById('zoom-out-btn') as HTMLButtonElement;

  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
  const copyBtnText = document.getElementById('copy-btn-text') as HTMLSpanElement;
