  const exactFontSelectWrapper = document.getElementById('exact-font-select-wrapper') as HTMLDivElement;
  const exactFontSelectEl = document.getElementById('exact-font-select') as HTMLSelectElement;
  const disabledFontTooltip = document.getElementById('disabled-font-tooltip') as HTMLDivElement;

  function updateExactFontDropdown() {
    if (!exactFontSelectWrapper || !exactFontSelectEl || !scriptSelectEl || !fontVersionSelectEl) return;
    
    const currentScript = scriptSelectEl.value;
    const currentFormat = fontVersionSelectEl.value;
    const isAltRaa = (document.getElementById('alt-raa-vatthu-chk') as HTMLInputElement)?.checked || false;

    exactFontSelectEl.innerHTML = '';
    
    // Check if we should show the exact font selector
    const shouldShow = (currentScript === 'hindi' && currentFormat === 'anuneo') || 
                       (currentScript === 'telugu' && currentFormat === 'anu7');
    
    if (shouldShow) {
      exactFontSelectWrapper.classList.remove('hidden');
      exactFontSelectWrapper.classList.add('flex');
    } else {
      exactFontSelectWrapper.classList.add('hidden');
      exactFontSelectWrapper.classList.remove('flex');
      return;
    }

    if (currentScript === 'hindi' && currentFormat === 'anuneo') {
      disabledFontTooltip.classList.add('hidden');
      exactFontSelectEl.innerHTML = HINDI_NEO_FONTS.map(opt => 
        `<option value="${opt.value}">${opt.label}</option>`
      ).join('');
    } else if (currentScript === 'telugu' && currentFormat === 'anu7') {
      disabledFontTooltip.classList.remove('hidden');
      
      const enabledFonts = isAltRaa ? TELUGU_RAA_FONTS : TELUGU_NORMAL_FONTS;
      const disabledFonts = isAltRaa ? TELUGU_NORMAL_FONTS : TELUGU_RAA_FONTS;
      
      let html = '';
      
      // Enabled fonts first
      enabledFonts.forEach(opt => {
        html += `<option value="${opt.value}" class="text-[var(--ink)]">${opt.label}</option>`;
      });
      
      // Disabled (greyed-out) mapped to a disabled option state
      let optgroupLabel = isAltRaa 
        ? "➜ Turn OFF 'Alt Raa Vatthu' to unlock these fonts:" 
        : "➜ Turn ON 'Alt Raa Vatthu' to unlock these fonts:";
        
      let hoverReason = isAltRaa ? i18nData.dataset.uncheck : i18nData.dataset.check;
      
      html += `<optgroup label="${optgroupLabel}" class="text-[var(--ink-tertiary)] italic">`;
      disabledFonts.forEach(opt => {
        html += `<option value="${opt.value}" disabled title="${hoverReason}" class="text-[var(--ink-tertiary)] hover:bg-transparent cursor-not-allowed">${opt.label} ${document.getElementById('i18n-data').dataset.disabled}</option>`;
      });
      html += `</optgroup>`;
      
      // Just the clean primary tooltip text here
      disabledFontTooltip.innerHTML = `<div class="absolute -top-1 left-4 w-2 h-2 bg-[#2D3039] border-t border-l border-[#40434F] rotate-45"></div>${document.getElementById("i18n-data").dataset.exact}`;
      
      // Attempt to preserve selection if it still is valid
      const prevVal = exactFontSelectEl.value;
      exactFontSelectEl.innerHTML = html;

      let valueSet = false;
      if (prevVal) {
        const matchingOpt = Array.from(exactFontSelectEl.options).find(o => o.value === prevVal && !o.disabled);
        if (matchingOpt) {
          exactFontSelectEl.value = prevVal;
          valueSet = true;
        }
      }
      
      // Default to Priyaanka (or first available) if no valid previous value
      if (!valueSet) {
        const priyaankaOpt = Array.from(exactFontSelectEl.options).find(o => o.value === 'Priyaanka');
        if (priyaankaOpt && !priyaankaOpt.disabled) {
           exactFontSelectEl.value = 'Priyaanka';
        } else {
           // fallback to first non-disabled
           const firstEnabled = Array.from(exactFontSelectEl.options).find(o => !o.disabled);
           if (firstEnabled) exactFontSelectEl.value = firstEnabled.value;
        }
      }
    }
  }

