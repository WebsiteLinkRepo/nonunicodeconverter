---
import Layout from '../../layouts/Layout.astro';
import { TRANSLATIONS, type Language } from '../../utils/i18n';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = TRANSLATIONS[lang];
---

<Layout title={t.downloadTitle} lang={lang}>
  <main class="container mx-auto px-4 py-16 max-w-4xl min-h-screen">
    <h1 class="text-4xl font-bold mb-4 text-[var(--ink)]">{t.downloadTitle}</h1>
    <p class="text-lg text-[var(--ink-secondary)] mb-12">
      {t.downloadDesc}
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- PWA Install -->
      <div class="border border-[var(--hairline)] rounded-xl p-6 shadow-sm bg-[var(--card-bg)] hover:border-[var(--hairline-strong)] transition-colors flex flex-col">
        <div class="w-10 h-10 bg-[var(--canvas-soft)] border border-[var(--hairline)] rounded-lg flex items-center justify-center mb-5">
          <svg class="w-5 h-5 text-[var(--ink)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h2 class="text-lg font-bold mb-2 text-[var(--ink)] tracking-tight">{t.pwaInstallTitle}</h2>
        <p class="text-[var(--ink-secondary)] mb-6 text-sm flex-grow">
          {t.pwaInstallDesc}
        </p>
        <button 
          id="pwa-install-btn"
          class="inline-flex items-center justify-center w-full px-4 py-2 border border-transparent text-sm font-bold rounded-md text-[var(--canvas)] bg-[var(--ink)] hover:opacity-80 transition-opacity mt-auto"
        >
          {t.pwaInstallBtn}
        </button>
      </div>

      <!-- PageMaker Auto Font Changer -->
      <div class="border border-[var(--hairline)] rounded-xl p-6 shadow-sm bg-[var(--card-bg)] hover:border-[var(--hairline-strong)] transition-colors flex flex-col">
        <div class="w-10 h-10 bg-[var(--canvas-soft)] border border-[var(--hairline)] rounded-lg flex items-center justify-center mb-5">
          <svg class="w-5 h-5 text-[var(--ink)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
        </div>
        <h2 class="text-lg font-bold mb-2 text-[var(--ink)] tracking-tight">{t.fontHelperTitle}</h2>
        <p class="text-[var(--ink-secondary)] mb-6 text-sm flex-grow">
          {t.fontHelperDesc}
        </p>
        <a 
          href="https://github.com/samuelvictor/nonunicodeconverter/releases/latest/download/pgmkrautofontchanger.exe" 
          class="inline-flex items-center justify-center w-full px-4 py-2 border border-transparent text-sm font-bold rounded-md text-[var(--canvas)] bg-[var(--ink)] hover:opacity-80 transition-opacity mt-auto"
        >
          {t.fontHelperBtn}
        </a>
      </div>
    </div>
  </main>

  <script>
    let deferredPrompt: any;
    const pwaBtn = document.getElementById('pwa-install-btn');

    window.addEventListener('beforeinstallprompt', (e) => {
      // Prevent the mini-infobar from appearing on mobile
      e.preventDefault();
      // Stash the event so it can be triggered later.
      deferredPrompt = e;
      if (pwaBtn) {
        pwaBtn.style.display = 'inline-flex';
      }
    });

    if (pwaBtn) {
      pwaBtn.addEventListener('click', async () => {
        if (deferredPrompt) {
          deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === 'accepted') {
            console.log('User accepted the install prompt');
          }
          deferredPrompt = null;
        } else {
          alert('PWA installation is not supported or already installed on this browser.');
        }
      });
    }
  </script>
</Layout>
