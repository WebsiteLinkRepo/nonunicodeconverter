---
---

<section id="benchmarks-section" class="w-full space-y-12 py-12">
  <!-- Mesh Gradient Feature Section -->
  <div class="relative rounded-2xl border border-[var(--hairline)] bg-[var(--canvas-soft)] p-8 sm:p-12 overflow-hidden shadow-vercel">
    <!-- Mesh Gradient Atmospheric Backdrop -->
    <div class="absolute inset-0 bg-mesh-gradient opacity-60 pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl space-y-4">
      <span class="px-2.5 py-1 rounded-full text-xs font-mono bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--brand-blue)] font-semibold inline-block">
        Developer-Grade Performance
      </span>
      <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight text-[var(--ink)] leading-tight">
        Engineered for speed, privacy & typographic safety.
      </h2>
      <p class="text-sm sm:text-base text-[var(--ink-secondary)] leading-relaxed">
        Unlike legacy PHP and WordPress-based converter pages that re-render full layouts or send sensitive text to remote servers, Unicode2NonUnicode operates 100% locally in your browser with zero latency and full offline support.
      </p>
    </div>

    <!-- Feature Grid (3-Up) -->
    <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6 mt-8 sm:mt-10">
      <!-- Card 1 -->
      <div class="bg-[var(--canvas)] border border-[var(--hairline)] rounded-xl p-6 shadow-vercel space-y-3 transition-all hover:border-[var(--hairline-strong)]">
        <div class="w-8 h-8 rounded-lg bg-[var(--canvas-soft-2)] border border-[var(--hairline)] flex items-center justify-center text-[var(--brand-blue)]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-semibold text-sm text-[var(--ink)]">Instant Edge Processing</h3>
        <p class="text-xs text-[var(--ink-secondary)] leading-normal">
          Sub-millisecond character transliteration pipeline with zero network overhead. Convert 100,000+ characters without browser freeze.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-[var(--canvas)] border border-[var(--hairline)] rounded-xl p-6 shadow-vercel space-y-3 transition-all hover:border-[var(--hairline-strong)]">
        <div class="w-8 h-8 rounded-lg bg-[var(--canvas-soft-2)] border border-[var(--hairline)] flex items-center justify-center text-[var(--brand-purple)]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="font-semibold text-sm text-[var(--ink)]">Glyph Safety & Error Check</h3>
        <p class="text-xs text-[var(--ink-secondary)] leading-normal">
          Automatic unmapped glyph detection and conjunct validation warnings prevent broken text blocks when publishing in InDesign or Word.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-[var(--canvas)] border border-[var(--hairline)] rounded-xl p-6 shadow-vercel space-y-3 transition-all hover:border-[var(--hairline-strong)]">
        <div class="w-8 h-8 rounded-lg bg-[var(--canvas-soft-2)] border border-[var(--hairline)] flex items-center justify-center text-[var(--brand-amber)]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
        </div>
        <h3 class="font-semibold text-sm text-[var(--ink)]">Optimized DTP & Translation Workflow</h3>
        <p class="text-xs text-[var(--ink-secondary)] leading-normal">
          Fast, efficient text conversion interface built specifically for translators, publishers, and DTP operators.
        </p>
      </div>
    </div>
  </div>

  <!-- Comparative Matrix vs Legacy Tools -->
  <div class="space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--ink-tertiary)]">Benchmark Matrix</span>
        <h3 class="text-xl font-semibold tracking-tight text-[var(--ink)]">Modern Edge App vs. Legacy Web Tools</h3>
      </div>
      <p class="text-xs text-[var(--ink-secondary)] font-mono">Tested on 50KB Telugu text payload</p>
    </div>

    <!-- Table -->
    <div class="border border-[var(--hairline)] rounded-xl overflow-hidden shadow-vercel bg-[var(--canvas)]">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[520px] text-left text-xs sm:text-sm font-sans">
          <thead class="bg-[var(--canvas-soft)] border-b border-[var(--hairline)] font-mono text-[11px] uppercase tracking-wider text-[var(--ink-secondary)]">
            <tr>
              <th class="p-3 sm:p-4">Feature / Metric</th>
              <th class="p-3 sm:p-4 text-[var(--brand-blue)] font-bold">unicode2nonunicode.com</th>
              <th class="p-3 sm:p-4 text-[var(--ink-tertiary)]">Kolichala / Legacy WP Tools</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--hairline)]">
            <tr class="hover:bg-[var(--canvas-soft-2)] transition-colors">
              <td class="p-3 sm:p-4 font-semibold text-[var(--ink)]">Initial Page Load</td>
              <td class="p-3 sm:p-4 font-mono font-semibold text-emerald-500">&lt; 40ms (Instant Edge)</td>
              <td class="p-3 sm:p-4 text-[var(--ink-secondary)]">3.8s - 6.2s (Heavy WP)</td>
            </tr>
            <tr class="hover:bg-[var(--canvas-soft-2)] transition-colors">
              <td class="p-3 sm:p-4 font-semibold text-[var(--ink)]">Transliteration Engine</td>
              <td class="p-3 sm:p-4 font-mono text-[var(--ink)]">Real-time instant (0ms lag)</td>
              <td class="p-3 sm:p-4 text-[var(--ink-secondary)]">On-click or full-page submit</td>
            </tr>
            <tr class="hover:bg-[var(--canvas-soft-2)] transition-colors">
              <td class="p-3 sm:p-4 font-semibold text-[var(--ink)]">File Upload / Batch Processing</td>
              <td class="p-3 sm:p-4 text-[var(--ink)] font-semibold flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Async chunking (no freeze)
              </td>
              <td class="p-3 sm:p-4 text-[var(--ink-secondary)]">No file upload support</td>
            </tr>
            <tr class="hover:bg-[var(--canvas-soft-2)] transition-colors">
              <td class="p-3 sm:p-4 font-semibold text-[var(--ink)]">Unmapped Glyph Safety Check</td>
              <td class="p-3 sm:p-4 text-[var(--ink)] font-semibold flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Automatic error inspector
              </td>
              <td class="p-3 sm:p-4 text-[var(--ink-secondary)]">Outputs corrupted blocks</td>
            </tr>
            <tr class="hover:bg-[var(--canvas-soft-2)] transition-colors">
              <td class="p-3 sm:p-4 font-semibold text-[var(--ink)]">Data Privacy & Security</td>
              <td class="p-3 sm:p-4 text-emerald-500 font-semibold">100% Client-side (No server logging)</td>
              <td class="p-3 sm:p-4 text-[var(--ink-secondary)]">Server POST processing</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
