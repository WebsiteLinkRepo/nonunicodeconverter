---
import Layout from '../layouts/Layout.astro';
import TextConverter from '../components/TextConverter.astro';
import SeoContent from '../components/SeoContent.astro';
import { TRANSLATIONS, type Language } from '../utils/i18n';

export function getStaticPaths() {
	return [
		{ params: { lang: 'te' } },
		{ params: { lang: 'en' } },
	];
}

const { lang } = Astro.params as { lang: Language };
const currentLang: Language = (lang in TRANSLATIONS) ? lang : 'en';
const t = TRANSLATIONS[currentLang];
---

<Layout 
	title={t.metaTitle}
	description={t.metaDescription}
	keywords={t.keywords}
	lang={currentLang}
>
	<div class="space-y-4 sm:space-y-6">
		<!-- Hero Section -->
		<div class="text-center pt-8 pb-2 sm:pt-12 sm:pb-4 space-y-4 flex flex-col items-center justify-center">
			<h1 id="page-title" class="text-2xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">
				{t.h1}
			</h1>
			<p id="page-subtitle" class="text-xs sm:text-base text-[var(--ink-secondary)] max-w-2xl mx-auto leading-relaxed">
				{t.subtitle}
			</p>
		</div>

		<!-- Main Converter Tool -->
		<TextConverter lang={currentLang} />

		<!-- 600+ Word SEO Guide & FAQ Section -->
		<SeoContent />
	</div>
</Layout>
