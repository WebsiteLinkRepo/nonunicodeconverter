---
import Layout from '../layouts/Layout.astro';
import TextConverter from '../components/TextConverter.astro';
import SeoContent from '../components/SeoContent.astro';
import { TRANSLATIONS } from '../utils/i18n';

const t = TRANSLATIONS.en;
---

<Layout 
	title={t.metaTitle}
	description={t.metaDescription}
	keywords={t.keywords}
	lang="en"
>
	<div class="space-y-8 sm:space-y-12">
		<!-- Hero Section -->
		<div class="text-center py-8 sm:py-16 space-y-4 flex flex-col items-center justify-center">
			<!-- Title -->
			<h1 id="page-title" class="text-4xl sm:text-6xl font-bold tracking-tighter text-transparent bg-clip-text bg-[image:var(--hero-gradient)] leading-[1.1] max-w-4xl mx-auto">
				{t.h1}
			</h1>

			<!-- Subtitle -->
			<p id="page-subtitle" class="text-sm sm:text-lg text-[var(--ink-secondary)] max-w-2xl mx-auto leading-relaxed font-medium">
				{t.subtitle}
			</p>
		</div>

		<!-- Main Converter Tool -->
		<TextConverter lang="en" />

		<!-- 600+ Word SEO Guide & FAQ Section -->
		<SeoContent />
	</div>
</Layout>
