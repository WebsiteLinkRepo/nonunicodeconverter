---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="404 - Page Not Found | NonUnicodeConverter.com"
	description="The page you are looking for does not exist on UnicodeToNonUnicode.com. Return to our free online Indic text font converter."
>
	<div class="max-w-4xl mx-auto py-12 sm:py-16 px-4 space-y-12">
		<!-- Hero 404 Graphic & Text Stack -->
		<div class="text-center space-y-6">
			<!-- Visual Monochrome 404 Badge -->
			<div class="relative inline-flex items-center justify-center">
				<span class="text-8xl sm:text-9xl font-extrabold font-mono tracking-tighter text-[var(--canvas-soft-2)] select-none">
					404
				</span>
				<div class="absolute inset-0 flex items-center justify-center">
					<div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-[var(--canvas-soft)] border border-[var(--hairline-strong)] flex items-center justify-center shadow-lg transform -rotate-3 transition-transform hover:rotate-0">
						<svg class="w-8 h-8 sm:w-10 sm:h-10 text-[var(--ink)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
				</div>
			</div>

			<!-- Main Heading & Subtitle -->
			<div class="space-y-3 max-w-lg mx-auto">
				<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">
					Lost in Transliteration?
				</h1>
				<p class="text-sm sm:text-base text-[var(--ink-secondary)] leading-relaxed">
					The URL path you requested doesn't exist or has been moved. Let's get you back to converting your Indic fonts!
				</p>
			</div>

			<!-- Primary CTA Buttons -->
			<div class="flex flex-wrap items-center justify-center gap-3 pt-2">
				<a 
					href="/" 
					class="px-6 py-3 bg-[var(--ink)] text-[var(--canvas)] font-semibold text-xs sm:text-sm rounded-xl hover:opacity-90 transition-all shadow-md flex items-center gap-2 cursor-pointer hover:scale-105"
				>
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
					</svg>
					Back to Converter Tool
				</a>

				<a 
					href="/contact" 
					class="px-6 py-3 bg-[var(--canvas)] border border-[var(--hairline-strong)] hover:bg-[var(--canvas-soft)] text-[var(--ink)] font-semibold text-xs sm:text-sm rounded-xl transition-all flex items-center gap-2 hover:scale-105"
				>
					<svg class="w-4 h-4 text-[var(--ink-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
					</svg>
					Contact & Support
				</a>
			</div>
		</div>

		<!-- Recommended Destinations Cards Grid -->
		<div class="pt-6 border-t border-[var(--hairline)] space-y-4">
			<div class="text-center space-y-1">
				<h2 class="text-xs font-mono uppercase tracking-wider text-[var(--ink-tertiary)]">Popular Destinations</h2>
				<p class="text-sm font-semibold text-[var(--ink)]">Where would you like to go?</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
				<!-- Card 1: Telugu Converter -->
				<a href="/te" class="group bg-[var(--canvas-soft)] border border-[var(--hairline)] hover:border-[var(--hairline-strong)] rounded-xl p-5 space-y-2 transition-all shadow-2xs hover:shadow-md">
					<div class="flex items-center justify-between">
						<span class="text-xs font-mono px-2 py-0.5 rounded bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink)] font-bold">TELUGU</span>
						<svg class="w-4 h-4 text-[var(--ink-tertiary)] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</div>
					<h3 class="font-semibold text-sm text-[var(--ink)]">Telugu Anu 6/7 Converter</h3>
					<p class="text-xs text-[var(--ink-secondary)]">Convert Telugu Unicode to Anu 7.0, Anu 6, and Shree-Lipi fonts.</p>
				</a>

				<!-- Card 2: Hindi Converter -->
				<a href="/hi" class="group bg-[var(--canvas-soft)] border border-[var(--hairline)] hover:border-[var(--hairline-strong)] rounded-xl p-5 space-y-2 transition-all shadow-2xs hover:shadow-md">
					<div class="flex items-center justify-between">
						<span class="text-xs font-mono px-2 py-0.5 rounded bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink)] font-bold">HINDI</span>
						<svg class="w-4 h-4 text-[var(--ink-tertiary)] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</div>
					<h3 class="font-semibold text-sm text-[var(--ink)]">Kruti Dev 010 Converter</h3>
					<p class="text-xs text-[var(--ink-secondary)]">Convert Mangal Hindi Unicode to Kruti Dev 010 and Shree-Lipi.</p>
				</a>

				<!-- Card 3: About Us -->
				<a href="/about" class="group bg-[var(--canvas-soft)] border border-[var(--hairline)] hover:border-[var(--hairline-strong)] rounded-xl p-5 space-y-2 transition-all shadow-2xs hover:shadow-md">
					<div class="flex items-center justify-between">
						<span class="text-xs font-mono px-2 py-0.5 rounded bg-[var(--canvas)] border border-[var(--hairline)] text-[var(--ink)] font-bold">ABOUT</span>
						<svg class="w-4 h-4 text-[var(--ink-tertiary)] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</div>
					<h3 class="font-semibold text-sm text-[var(--ink)]">About Our Engine</h3>
					<p class="text-xs text-[var(--ink-secondary)]">Learn how our 100% browser-local DTP converter works.</p>
				</a>
			</div>
		</div>
	</div>
</Layout>
