---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Terms & Conditions | Unicode To Non-Unicode Converter"
	description="Terms of Service and Conditions of Use for UnicodeToNonUnicode.com. Free online tool for Indic text font conversion."
	keywords="terms and conditions unicode to non unicode, terms of service indic font converter"
>
	<div class="max-w-4xl mx-auto space-y-8 py-4 sm:py-8">
		<!-- Page Header -->
		<div class="border-b border-[var(--hairline)] pb-6 space-y-3">
			<span class="px-2.5 py-1 rounded-full text-xs font-mono bg-[var(--canvas-soft-2)] border border-[var(--hairline)] text-[var(--ink-secondary)] font-semibold inline-block uppercase tracking-wider">
				Legal Documentation
			</span>
			<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">
				Terms & Conditions
			</h1>
			<p class="text-sm text-[var(--ink-secondary)]">
				Last Updated: August 12, 2026
			</p>
		</div>

		<!-- Main Terms Body -->
		<div class="space-y-6 text-sm text-[var(--ink-secondary)] leading-relaxed">
			<!-- Section 1 -->
			<div class="bg-[var(--canvas-soft)] border border-[var(--hairline)] rounded-xl p-6 space-y-3">
				<h2 class="text-xl font-bold text-[var(--ink)]">1. Acceptance of Terms</h2>
				<p>
					By accessing or using <strong>UnicodeToNonUnicode.com</strong>, you agree to be bound by these Terms and Conditions. If you do not agree to these terms, please do not use the website.
				</p>
			</div>

			<!-- Section 2 -->
			<div class="bg-[var(--canvas)] border border-[var(--hairline)] rounded-xl p-6 space-y-3">
				<h2 class="text-xl font-bold text-[var(--ink)]">2. Permitted Use</h2>
				<p>
					You are granted a non-exclusive, free license to use this web utility for personal, commercial, desktop publishing (DTP), newspaper typesetting, translation, and enterprise projects. No fee or subscription is required.
				</p>
			</div>

			<!-- Section 3 -->
			<div class="bg-[var(--canvas)] border border-[var(--hairline)] rounded-xl p-6 space-y-3">
				<h2 class="text-xl font-bold text-[var(--ink)]">3. Trademark & Intellectual Property Disclaimer</h2>
				<p>
					All font brand names and trademarks mentioned on this website—including but not limited to <em>Anu Graphic Systems (Anu 6, Anu 7.0)</em>, <em>Kruti Dev</em>, <em>Shree-Lipi (Modular InfoTech)</em>, <em>Bamini</em>, and <em>C-DAC ISM Revathi</em>—are the property of their respective copyright holders.
				</p>
				<p>
					UnicodeToNonUnicode.com provides an independent character mapping utility to facilitate interoperability between standard international Unicode text and legacy ASCII font character layouts.
				</p>
			</div>

			<!-- Section 4 -->
			<div class="bg-[var(--canvas)] border border-[var(--hairline)] rounded-xl p-6 space-y-3">
				<h2 class="text-xl font-bold text-[var(--ink)]">4. Limitation of Liability</h2>
				<p>
					The service is provided on an "AS IS" and "AS AVAILABLE" basis without warranties of any kind. While we strive for 100% conversion accuracy, UnicodeToNonUnicode.com shall not be held liable for any typographical errors, unmapped glyphs, data loss, or publishing delays resulting from the use of this tool. Users are encouraged to verify converted text prior to printing.
				</p>
			</div>

			<!-- Section 5 -->
			<div class="bg-[var(--canvas-soft)] border border-[var(--hairline)] rounded-xl p-6 space-y-3">
				<h2 class="text-xl font-bold text-[var(--ink)]">5. Contact Information</h2>
				<p>
					For questions or inquiries regarding these Terms & Conditions, please contact us via our <a href="/contact" class="underline text-[var(--ink)] font-semibold">Contact Page</a>.
				</p>
			</div>
		</div>
	</div>
</Layout>
